# LLM providers: configure at least one valid key.
# Option 1: SiliconFlow (DeepSeek / Qwen)
SILICONFLOW_API_KEY=sk-your-key-here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3

# Option 2: DashScope (Tongyi Qwen) - OpenAI compatible endpoint
# Get free tokens at https://dashscope.aliyun.com
DASHSCOPE_API_KEY=sk-your-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-turbo

EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
DATABASE_URL=sqlite+aiosqlite:///./macau_mystery.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_ENV=development
BOOTSTRAP_DEMO_STORY=true
BOOTSTRAP_DEMO_USERS=true
AUTH_TOKEN_TTL_HOURS=168
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=admin123
DEMO_GUEST_USERNAME=guest
DEMO_GUEST_PASSWORD=guest123
ADMIN_TOKEN=admin-secret-token-change-me

# S3-compatible media storage. These defaults target a MinIO process exposed on localhost.
# Docker Compose overrides S3_ENDPOINT_URL with the internal service hostname while keeping
# S3_PRESIGN_ENDPOINT_URL browser-accessible.
OBJECT_STORAGE_ENABLED=true
S3_ENDPOINT_URL=http://localhost:9000
S3_PRESIGN_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=macau-media
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/macau-media
# R2 部署示例：S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com，
# S3_REGION=auto、S3_ADDRESSING_STYLE=path；公开播放域名单独配置到 MEDIA_PUBLIC_BASE_URL。
MEDIA_UPLOAD_TTL_SECONDS=900
MEDIA_MAX_VIDEO_BYTES=1073741824
MEDIA_MAX_POSTER_BYTES=10485760
MEDIA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
